{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Visual Studio 2026 (x64)",
            "description": "Default build with Visual Studio 2026 generator",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "kunpeng-release",
            "displayName": "Kunpeng ARM64 Release",
            "description": "Build for Huawei Kunpeng ARM64 servers (Linux)",
            "toolchainFile": "${sourceDir}/cmake/kunpeng_arm64_toolchain.cmake",
            "binaryDir": "${sourceDir}/build-kunpeng",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_VERBOSE_MAKEFILE": "ON"
            }
        },
        {
            "name": "kunpeng-debug",
            "displayName": "Kunpeng ARM64 Debug",
            "description": "Debug build for Huawei Kunpeng ARM64 servers (Linux)",
            "toolchainFile": "${sourceDir}/cmake/kunpeng_arm64_toolchain.cmake",
            "binaryDir": "${sourceDir}/build-kunpeng-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_VERBOSE_MAKEFILE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "default",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "kunpeng-release",
            "configurePreset": "kunpeng-release",
            "configuration": "Release"
        },
        {
            "name": "kunpeng-debug",
            "configurePreset": "kunpeng-debug",
            "configuration": "Debug"
        }
    ]
}
